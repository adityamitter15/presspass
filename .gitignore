# macOS
.DS_Store

# Xcode build output and per-user state
build/
DerivedData/
xcuserdata/
*.xcuserstate

# Generated by XcodeGen and CocoaPods: run `xcodegen generate && pod install`
PushupTime.xcodeproj/
PushupTime.xcworkspace/
Pods/

# SwiftPM
.build/
.swiftpm/

# Python
training/.venv/
training/models/
__pycache__/
*.pyc

# Local signing overrides
Config/*.local.xcconfig

# Private working notes, not part of the published project
research_notes/
reports/

# Signed consent sheets and the name-to-label list: never published
private/

# Take videos are never committed (they stay in private/video/, see
# scripts/pull_recordings.sh); these catch one copied in by mistake
data/sessions/*.mp4
data/sessions/*.mov

# Evaluation tooling
eval/.venv/
.pytest_cache/
